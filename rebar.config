%% Dep-LIGHT on purpose. jsx is pure Erlang with no NIFs, so this repo builds in
%% seconds with no Rust toolchain, no ONNX, no AVX2 requirement.
%%
%% It deliberately does NOT depend on hecate-spartan. Pinning the service would
%% drag macula, reckon-db, evoq and their Rust NIFs into a harness that needs a
%% URL and a model name, and would couple every experiment's reproducibility to
%% whether that stack still builds. hecate-arena is dep-free for the same reason.
%%
%% Where an experiment's SUBJECT genuinely is hecate-spartan code (the defusal and
%% recall programmes), that experiment pins it deliberately, in its own directory,
%% and records the pin. That is a per-experiment decision, not a repo-wide one.
{deps, [{jsx, "~> 3.1"}]}.

{erl_opts, [debug_info, warnings_as_errors]}.

%% experiments/ is the ACTIVE working area and compiles.
%% programmes/ is the ARCHIVE and is deliberately absent from every source path,
%% so an archived runner is a record rather than a build input. It never compiles
%% again, and it never runs on this repo's test suite.
{src_dirs, ["src", "experiments"]}.

{eunit_opts, [verbose]}.

{dialyzer, [{warnings, [unknown]}]}.

{project_plugins, [rebar3_lint]}.

{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [#{files => ["src/**/*.erl", "experiments/**/*.erl"], ruleset => macula_min}]}
]}.
